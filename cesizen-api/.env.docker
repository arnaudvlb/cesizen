APP_ENV=prod
APP_SECRET=change_me_for_local_docker

DATABASE_URL="mysql://cesizen:cesizen@database:3306/cesizen?serverVersion=8.4&charset=utf8mb4"
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"

